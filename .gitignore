# API keys — never commit
lib/config/api_keys.dart
# Obsolete — setup_web.sh is no longer used (Maps key injected via Dart).
# Kept here as a safeguard in case old files still exist locally.
web/index.html.local
web/index.html.placeholder

# Claude Code agent worktrees and package mirrors — generated, never commit
.claude/worktrees/
.claude/packages/

